{
  "name": "noctune-android",
  "version": "1.0.0",
  "private": true,
  "description": "Native Android wrapper for Noctune (Capacitor)",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && cap sync android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk": "npm run sync && npm run apk:debug"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/preferences": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3"
  }
}
